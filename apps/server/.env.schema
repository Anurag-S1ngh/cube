# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=url @sensitive=false
CORS_ORIGIN=

# Public base URL of this API (used to build webhook endpoints).
# @type=url @sensitive=false
SERVER_PUBLIC_URL=http://localhost:3000

# @type=string(minLength=1)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Payment failure resolution agent integrations
# ---------------------------------------------------------------------------

# cfo.ai financial model (MCP server). Reads model context + writes scenarios.
# @type=url @sensitive=false
CFO_AI_MCP_URL=https://api.cfo.ai/mcp

# @required=false
CFO_AI_TOKEN=

# @required=false @sensitive=false
CFO_AI_ORG_ID=

# Where the OAuth tokens from `bun run cfo:login` are cached (gitignored).
# @required=false @sensitive=false
CFO_AI_CREDENTIALS_PATH=.cfo-ai/credentials.json

# neatlogs agent observability (traces, detections, alerts).
# @required=false
NEATLOGS_API_KEY=

# Email delivery: "resend" calls the Resend API, "mock" writes to the DB only.
# Falls back to mock automatically when no RESEND_API_KEY is set.
# @type=enum(mock, resend) @sensitive=false
EMAIL_PROVIDER=resend

# Resend API key (re_...). Without it, email delivery falls back to mock.
# @required=false
RESEND_API_KEY=

# Verified Resend sender. onboarding@resend.dev works for testing.
# @required=false @sensitive=false
EMAIL_FROM=onboarding@resend.dev

# Staging safety net: when set, all reminder emails are redirected to this
# address instead of the (often fake) customer address. Leave empty in prod.
# @required=false @sensitive=false
EMAIL_OVERRIDE_TO=

# LLM used to enrich cause/mitigation reasoning (OpenAI-compatible endpoint).
# Defaults to Gemini's OpenAI-compatible API.
# @required=false
LLM_API_KEY=

# @required=false @type=url @sensitive=false
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# @required=false @sensitive=false
LLM_MODEL=gemini-2.5-flash

# HMAC secret for the mock payment provider webhooks.
# @type=string(minLength=1)
MOCK_WEBHOOK_SECRET=whsec_mock_dev

# When true the agent sends guardrail-passing reminder emails automatically.
# @type=boolean @sensitive=false
AGENT_AUTO_SEND=true

# ---------------------------------------------------------------------------
# Dashboard auth
# ---------------------------------------------------------------------------

# Name of the httpOnly session cookie set on login.
# @sensitive=false
SESSION_COOKIE_NAME=cube_session

# Session lifetime in days.
# @type=number @sensitive=false
SESSION_TTL_DAYS=30

# Failed login attempts allowed per window before an identifier is throttled.
# @type=number @sensitive=false
AUTH_LOGIN_MAX_ATTEMPTS=5

# Login rate-limit window in minutes.
# @type=number @sensitive=false
AUTH_LOGIN_WINDOW_MINUTES=15
