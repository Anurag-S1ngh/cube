# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Payment failure resolution agent integrations
# ---------------------------------------------------------------------------

# cfo.ai financial model (MCP server). Reads model context + writes scenarios.
# @type=url
CFO_AI_MCP_URL=https://api.cfo.ai/mcp

# @required=false
CFO_AI_TOKEN=

# @required=false
CFO_AI_ORG_ID=

# neatlogs agent observability (traces, detections, alerts).
# @required=false
NEATLOGS_API_KEY=

# Email delivery: "mock" writes to the DB only, "resend" calls the Resend API.
# @type=enum(mock, resend)
EMAIL_PROVIDER=mock

# @required=false
EMAIL_API_KEY=

# @required=false
EMAIL_FROM=payments@example.com

# LLM used for cause classification and mitigation reasoning.
# @required=false
LLM_API_KEY=

# @required=false @type=url
LLM_BASE_URL=https://api.openai.com/v1

# @required=false
LLM_MODEL=gpt-4o-mini
