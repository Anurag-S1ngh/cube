{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cfoai": {
      "type": "remote",
      "url": "https://api.cfo.ai/mcp",
      "enabled": true
    },
    "neatlogs": {
      "type": "remote",
      "url": "https://ingest.neatlogs.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:NEATLOGS_API_KEY}"
      },
      "enabled": true
    }
  }
}
