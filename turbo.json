{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "cache": false
    },
    "seed": {
      "cache": false
    },
    "simulate": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "CI",
    "CORS_ORIGIN",
    "DATABASE_URL",
    "NEXT_PUBLIC_SERVER_URL",
    "NEXT_PUBLIC_NEATLOGS_TRACE_URL",
    "NEXT_PUBLIC_CFO_AI_SCENARIO_URL",
    "NEXT_PUBLIC_ENTIRE_CHECKPOINT_URL",
    "NODE_ENV",
    "CFO_AI_MCP_URL",
    "CFO_AI_TOKEN",
    "CFO_AI_ORG_ID",
    "NEATLOGS_API_KEY",
    "EMAIL_PROVIDER",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "EMAIL_OVERRIDE_TO",
    "LLM_API_KEY",
    "LLM_BASE_URL",
    "LLM_MODEL",
    "MOCK_WEBHOOK_SECRET",
    "AGENT_AUTO_SEND",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL",
    "_VARLOCK_ENV_KEY"
  ],
  "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
